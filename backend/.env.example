# Copy this file to .env and adjust as needed.

# Default is a local SQLite file - zero setup required.
# To use Supabase/Postgres instead, set this to your Supabase connection string, e.g.:
# postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./legal_metrology.db

# Default admin account created automatically on first run (in Supabase Auth).
DEFAULT_ADMIN_EMAIL=admin@legalmetrology.gov.in
DEFAULT_ADMIN_PASSWORD=Admin@123
DEFAULT_ADMIN_NAME=Chief Inspector

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Groq API key (free at https://console.groq.com/keys). Used to clean up noisy
# OCR text, fill in declarations the regex engine could not confidently find,
# and write plain-language compliance summaries. The rule engine still makes
# every compliant/non-compliant decision - the AI layer is purely assistive
# and the app runs fine (skips this step) if left blank.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Vision-capable model used to look at the label photo directly (recovering
# declarations OCR misread, flagging visible legibility issues, and writing
# the report summary). Groq's model lineup changes over time - if this 404s,
# run `client.models.list()` against your key to see what's currently live.
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Supabase project URL and keys. Get these from Settings -> Data API (Project
# URL) and Settings -> API Keys (publishable/anon key, and service_role
# secret key). Storage falls back to local disk if left blank, but Auth has
# no local fallback - the app can't authenticate anyone without these set.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=label-images
